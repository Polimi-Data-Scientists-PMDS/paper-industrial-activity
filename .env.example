# Copy to .env, fill in, then load it in your shell:  set -a; source .env; set +a

# Google Cloud project used for Earth Engine and Cloud Storage
GCP_PROJECT=your-gcp-project

# Bucket where Earth Engine exports the detections
GCS_BUCKET=your-detections-bucket

# PostGIS database (through an SSH tunnel, see docs/pipeline.md)
DATABASE_URL=postgresql://user:password@localhost:5433/database
